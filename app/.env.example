PORT=80
ENABLE_WEB_APP=true
WEB_APP_PATH=
COOLIFY_BASE_URL=https://coolify.example.com/api
COOLIFY_TOKEN=token-example
GAME_PRESETS=[
  {
    "id": "default-game",
    "name": "Serveur par defaut",
    "serviceId": "service-id-par-defaut",
    "imageUrl": "https://example.com/default-image.png",
    "discordVoiceChannelIds": ["123456789012345678"],
    "instructions": "Consignes affichées dans le salon Discord"
  }
]
GAME_PRESETS_FILE=/data/game-presets.json
DISCORD_TOKEN=bot-token
SERVER_STOP_DELAY_SECONDS=600
# Option legacy si vous ne voulez pas embarquer les salons dans GAME_PRESETS :
# DISCORD_DEFAULT_GAME_ID=default-game
# DISCORD_VOICE_CHANNEL_ID=123456789012345678
# Ou utilisez DISCORD_GAME_CHANNEL_MAPPINGS pour mapper plusieurs salons sans toucher à GAME_PRESETS :
# DISCORD_GAME_CHANNEL_MAPPINGS=[{"channelId":"123","gameId":"default-game","instructions":"Consignes par jeu"}]
# Pour définir des instructions par jeu sans redéfinir tout le mapping, utilisez :
# DISCORD_GAME_INSTRUCTION_MAPPINGS={"default-game":"Consignes affichées dans Discord"}
